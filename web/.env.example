# Leave blank for local dev — requests go to /api and the Vite proxy forwards to localhost:3000.
# Set to the deployed API base URL in production (e.g. https://api.anywent.com).
VITE_API_URL=

# Clerk publishable key — get from https://dashboard.clerk.com → API Keys
# Use the pk_test_... key for local dev, pk_live_... for production.
VITE_CLERK_PUBLISHABLE_KEY=
