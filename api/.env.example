NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Clerk auth
CLERK_SECRET_KEY=

# Scrapers
# GoOut: no API key needed — public endpoint
# Songkick: closed to new registrations as of 2024 — skip for now
SONGKICK_API_KEY=

# Error monitoring (Sentry — install from day one)
SENTRY_DSN=

# CORS — leave blank for local dev (allows all origins); set to frontend URL in production
CORS_ORIGIN=

# Admin
ADMIN_SECRET=
